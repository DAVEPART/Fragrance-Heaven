# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_URL=jdbc:mysql://localhost:3306/fragrance_heaven?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate a strong secret key (at least 256 bits)
# You can use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_this_to_secure_value

# ==========================================
# ADMIN CREDENTIALS
# ==========================================
ADMIN_EMAIL=admin@fragrance.com
ADMIN_PASSWORD=your_admin_password_here

# ==========================================
# STRIPE PAYMENT GATEWAY
# ==========================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ==========================================
# SERVER CONFIGURATION
# ==========================================
SERVER_PORT=8080
